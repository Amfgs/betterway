{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/maintenance/run",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/maintenance/daily-reminders",
      "schedule": "30 0 * * *"
    }
  ]
}
